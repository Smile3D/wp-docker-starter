# Скопируй в .env и поменяй под конкретный проект
# (особенно порты, если запускаешь несколько проектов локально одновременно)

# --- База данных ---
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=wordpress
MYSQL_ROOT_PASSWORD=root

# --- Порты ---
WORDPRESS_PORT=8080
PHPMYADMIN_PORT=8081

# --- Установка WP ---
WP_TITLE="New Project"
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin
WP_ADMIN_EMAIL=admin@example.com
WP_LOCALE=ru_RU

# --- Тема ---
THEME_NAME=my-theme
